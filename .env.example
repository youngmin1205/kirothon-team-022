# KIROTHON 2026 환경변수 템플릿
# 복사해서 쓰기: cp .env.example .env   (.env는 .gitignore에 있어 커밋되지 않음)
# 키·토큰은 이 파일에 적지 않는다. 실제 값은 로컬 .env에만 둔다.

# ─────────────────────────────────────────────────────────────
# (A) 사전 준비용 — 내 AWS 프로필을 쓸 때
#     행사 전 연습과 개발에 사용한다.
# ─────────────────────────────────────────────────────────────
AWS_PROFILE=hackathon
AWS_REGION=us-west-2

# ─────────────────────────────────────────────────────────────
# (B) 당일 주최 측 계정 — 임시 자격증명을 받을 때
#     (A)의 AWS_PROFILE을 주석 처리하고 아래를 채운다.
#     EC2에 올릴 때는 둘 다 비우고 인스턴스 역할에 맡긴다.
# ─────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=

# ─────────────────────────────────────────────────────────────
# Bedrock
# ─────────────────────────────────────────────────────────────
# inference profile ID를 쓴다. (us. / global. 접두어 주의)
# 계정을 받은 직후 아래 스크립트가 쓸 수 있는 ID를 찾아 출력한다:
#   ./scripts/aws-check.sh
BEDROCK_MODEL_ID=

# ─────────────────────────────────────────────────────────────
# 실행 모드
# ─────────────────────────────────────────────────────────────
# 1이면 Bedrock을 호출하지 않고 고정 시나리오를 재생한다.
# 데모 녹화와 시연의 기본값. 네트워크·크레딧·throttling과 무관하게 완주한다.
USE_MOCK=0

# ─────────────────────────────────────────────────────────────
# 첨부 파일
# ─────────────────────────────────────────────────────────────
# 사진·CSV·PDF를 JSON 안의 base64로 받는다. 파일 하나의 상한(MB).
# 올리면 프런트의 frontend/src/lib/files.ts MAX_BYTES도 같이 맞춘다.
ATTACHMENT_MAX_MB=5

# ─────────────────────────────────────────────────────────────
# MCP/Power 토큰 (필요할 때, 각자 PC의 .env에만)
# ─────────────────────────────────────────────────────────────
# GITHUB_TOKEN=
